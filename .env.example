# ── Paperclip ─────────────────────────────────────────────────────────────────
# URL of the Paperclip control plane (local default shown)
PAPERCLIP_API_URL=http://localhost:3000

# Short-lived JWT or long-lived API key for agent authentication
PAPERCLIP_API_KEY=

# ID of the CEO agent that receives delegated tasks from voice commands
PAPERCLIP_CEO_AGENT_ID=

# ── Obsidian local REST API ───────────────────────────────────────────────────
# Host where the obsidian-local-rest-api plugin is running
OBSIDIAN_HOST=http://127.0.0.1

# Port for the Obsidian REST API (default: 27123)
OBSIDIAN_PORT=27123

# Bearer token if the plugin is configured to require authentication (leave blank if not)
OBSIDIAN_API_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection URL used by the orchestrator for the task queue and event bus
REDIS_URL=redis://localhost:6379

# ── Orchestrator ─────────────────────────────────────────────────────────────
# URL of the FastAPI + Socket.IO orchestrator (consumed by browser-client)
ORCHESTRATOR_URL=http://localhost:8000

# ── E2E test ─────────────────────────────────────────────────────────────────
# Vault-relative path for the E2E test note written by test_e2e.py
TEST_NOTE_PATH=jarvis/e2e-test.md
